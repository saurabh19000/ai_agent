# LiveKit configuration
LIVEKIT_URL=wss://your-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI
GOOGLE_API_KEY=

# LLM provider (openai or google)
LLM_PROVIDER=openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Voice / STT / TTS
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
TTS_VOICE_ID=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Embeddings model for RAG
EMBEDDINGS_MODEL=models/text-embedding-004

# HRMS backend
HRMS_BACKEND_URL=http://localhost:8000
AI_AGENT_API_KEY=

# Token server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
TOKEN_SERVER_PUBLIC_URL=http://localhost:8000

# LiveKit meet URL (cosmetic, for startup message only)
LIVEKIT_MEET_URL=https://meet.livekit.io
